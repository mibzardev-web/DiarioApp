{
  "expo": {
    "name": "Diario de Campo",
    "slug": "DiarioApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B79CE8",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que Diario de Campo use Face ID para desbloquear tus diarios."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8ee376f0-a4e7-4bd4-b48e-71932bce63eb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8ee376f0-a4e7-4bd4-b48e-71932bce63eb"
    }
  }
}
